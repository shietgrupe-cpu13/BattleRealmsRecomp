<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.battlerealms.nativeport">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <application
        android:name="org.battlerealms.nativeport.BattleRealmsApplication"
        android:allowBackup="false"
        android:hasCode="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <provider
            android:name="org.battlerealms.nativeport.DiagnosticsLogProvider"
            android:authorities="org.battlerealms.nativeport.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name="org.battlerealms.nativeport.LauncherActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.battlerealms.nativeport.GameActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="brnative" />
        </activity>
    </application>
</manifest>
